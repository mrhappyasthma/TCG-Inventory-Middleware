# ============================================================
# TCG Inventory Middleware - Environment Configuration
# ============================================================

# Host port mapping (change if 8080 is already used on Synology NAS)
HOST_PORT=8080

# ------------------------------------------------------------
# Google Sign-In (REQUIRED)
# ------------------------------------------------------------
# This application authenticates exclusively through Google Sign-In. The app
# will refuse to start without a Client ID.
#
# Create one in the Google Auth Platform > Clients tab:
#   https://console.cloud.google.com/auth/clients  >  Create client
#   Application type: Web application
#
# Register your Authorized JavaScript origins. Google rejects raw IP addresses
# and plain HTTP, so http://192.168.x.x:8080 can NEVER be authorized. Use:
#   https://cards.yourname.synology.me   (production, via DSM reverse proxy)
#   http://localhost:8080          (local development)
#
# Leave Authorized redirect URIs EMPTY - this flow uses postMessage, not a
# redirect. There is also no client secret; the Client ID alone is sufficient
# and is safe to expose in the browser.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# Session security
# ------------------------------------------------------------
# Secret used to sign session cookies. If left blank, a random secret is
# generated on first boot and persisted to data/.session_secret, which is fine
# for a single instance. Set it explicitly to keep sessions valid across a
# rebuild that wipes the data directory. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Send the session cookie only over HTTPS. Keep this true in production.
# Set it to false for local development over http://localhost.
COOKIE_SECURE=true

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
# Database Paths (automatically mapped to /data volume in Docker)
DATABASE_URL=data/inventory.db
USER_DATABASE_URL=data/users.db
SESSION_SECRET_FILE=data/.session_secret

# Market price refresh (TCGCSV). Their data updates once a day and
# they ask for at most one sync per 24 hours, so a shorter interval
# only wastes requests against a service that asks us not to.
PRICE_REFRESH_ENABLED=true
PRICE_REFRESH_INTERVAL_HOURS=24

# Ceiling on any single upload, in megabytes.
MAX_UPLOAD_MB=25

# ------------------------------------------------------------
# eBay APIs (OPTIONAL)
# ------------------------------------------------------------
# Leave these blank to keep the app working purely as a CSV tool. When they
# are set, the dashboard can connect an eBay account and push approved drafts
# directly instead of generating files for Seller Hub.
#
# Create the keyset at https://developer.ebay.com/my/keys and take the App ID
# (client id) and Cert ID (client secret). EBAY_REDIRECT_URI is eBay's RuName,
# NOT a URL: it names the redirect you configured on the keyset, and the
# actual redirect URL is set in eBay's console rather than sent per request.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=

# sandbox or production. Sandbox is an entirely separate installation with its
# own credentials, listings and orders; nothing crosses over. Start there.
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_US

# Echoed back to eBay when it validates the notification endpoint. Must be
# 32-80 characters of letters, digits, underscore and hyphen. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EBAY_VERIFICATION_TOKEN=

# The public HTTPS URL eBay will call, exactly as entered in eBay's console.
# It must be the outside URL, not what the container sees: the endpoint
# challenge hashes this string, so a mismatch behind the reverse proxy fails
# validation with an error that does not say why.
EBAY_NOTIFICATION_ENDPOINT=
