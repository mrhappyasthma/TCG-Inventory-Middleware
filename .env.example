# ============================================================
# TCG Inventory Middleware - Environment Configuration
# ============================================================

# Host port mapping (change if 8080 is already used on Synology NAS)
HOST_PORT=8080

# Authentication method: 'local' (username/password), 'google', or 'none' (for offline dev)
AUTH_METHOD=local

# Secret key used for signing JWT session tokens (generate a long random string in production)
JWT_SECRET=super-secret-key-change-in-production-123456789

# Optional: Google OAuth 2.0 Client ID (from Google Cloud Console) if using Google Sign-In
GOOGLE_CLIENT_ID=

# Database Paths (automatically mapped to /data volume in Docker)
DATABASE_URL=data/inventory.db
USER_DATABASE_URL=data/users.db
